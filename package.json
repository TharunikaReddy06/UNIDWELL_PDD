{
  "name": "unidwell-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npm run build && npx cap sync android && npx cap run android",
    "android:debug": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "android:release": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleRelease",
    "assets:generate": "npx @capacitor/assets generate --iconBackgroundColor #0EA5A4 --iconBackgroundColorDark #0F172A --splashBackgroundColor #0F172A --splashBackgroundColorDark #0F172A"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@emailjs/browser": "^4.4.1",
    "@hookform/resolvers": "^5.5.7",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "exceljs": "^4.4.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.23",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
